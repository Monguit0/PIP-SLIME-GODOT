; Engine configuration file.
; Godot 4.x

config_version=5

[application]

config/name="Pip y los Slimes"
config/description="Versión Godot de Pip y los Slimes."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=512
window/size/viewport_height=288
window/size/window_width_override=1024
window/size/window_height_override=576
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[layer_names]

2d_physics/layer_1="suelo"
2d_physics/layer_2="plataformas"
2d_physics/layer_3="heroe"
2d_physics/layer_4="enemigos"
2d_physics/layer_5="blanco_flechas"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0, 0, 0.14, 1)

[autoload]

Fx="*res://scripts/fx.gd"
